---
import BaseLayout from '../layouts/BaseLayout.astro';
import { history, projects } from '../data/projects';

const title = 'Arca Computer Web3 — Shipped and verifiable';
const description = 'Arca Computer builds onchain products and infrastructure across Base, Farcaster, Snapchain, identity, payments, wallets, and digital culture.';
---
<BaseLayout {title} {description}>
  <header class="site-header">
    <a class="brand" href="https://arca.computer" aria-label="Arca Computer home">
      <img src="/arca-logo.svg" alt="" width="54" height="54" />
      <span>ARCA COMPUTER</span>
    </a>
    <nav aria-label="Primary navigation">
      <a href="#work">Work</a>
      <a href="#history">History</a>
      <a href="#receipts">Receipts</a>
    </nav>
    <a class="header-link" href="https://farcaster.xyz/felirami.eth" target="_blank" rel="noreferrer">felirami.eth ↗</a>
  </header>

  <main id="content" tabindex="-1">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">ARCA COMPUTER / WEB3 FIELD INDEX</p>
        <h1 id="hero-title">Web3 work.<br /><em>Shipped and verifiable.</em></h1>
        <p class="hero-intro">From onchain art and virtual worlds to Farcaster apps, Base infrastructure, agent identity, payments, and node operations. Built from Santiago since 2021.</p>
        <div class="hero-actions">
          <a class="button" href="#work">Inspect the work</a>
          <a class="text-link" href="https://github.com/arcacomputer" target="_blank" rel="noreferrer">Company GitHub ↗</a>
        </div>
      </div>
      <div class="trace-panel" aria-label="Arca web3 system map">
        <div class="trace-label">LIVE SYSTEM MAP / 2026</div>
        <svg viewBox="0 0 620 420" role="img" aria-labelledby="map-title map-desc">
          <title id="map-title">Arca web3 system map</title>
          <desc id="map-desc">A network joining culture, social applications, infrastructure, identity, payments, and public evidence.</desc>
          <g class="trace-lines">
            <path d="M66 86H212L278 150H426L510 66" />
            <path d="M66 334H196L276 258H430L546 340" />
            <path d="M278 150V258" />
            <path d="M426 150V258" />
            <path d="M196 334V382" />
          </g>
          <g class="trace-nodes">
            <circle cx="66" cy="86" r="7" /><circle cx="510" cy="66" r="7" />
            <circle cx="66" cy="334" r="7" /><circle cx="546" cy="340" r="7" />
            <circle cx="278" cy="150" r="7" /><circle cx="426" cy="150" r="7" />
            <circle cx="276" cy="258" r="7" /><circle cx="430" cy="258" r="7" />
          </g>
          <g class="trace-copy">
            <text x="66" y="60">CULTURE</text>
            <text x="510" y="40" text-anchor="end">IDENTITY</text>
            <text x="66" y="370">SOCIAL</text>
            <text x="546" y="376" text-anchor="end">PAYMENTS</text>
            <text x="278" y="132" text-anchor="middle">DATA</text>
            <text x="426" y="132" text-anchor="middle">NODES</text>
            <text x="352" y="215" text-anchor="middle" class="trace-core">ARCA</text>
            <text x="196" y="408" text-anchor="middle">PUBLIC RECEIPTS</text>
          </g>
        </svg>
        <div class="trace-status"><span></span> Santiago node online</div>
      </div>
    </section>

    <section class="signal-strip" aria-label="Portfolio focus. Scroll horizontally for more." tabindex="0">
      <span>Base</span><span>Farcaster</span><span>Snapchain</span><span>ERC-8004</span><span>x402</span><span>Wallets</span><span>NFT data</span>
    </section>

    <section id="work" class="featured section-shell" aria-labelledby="featured-title">
      <div class="section-index">01 / FEATURED SYSTEM</div>
      <div class="featured-grid">
        <div class="featured-copy">
          <div class="status-row"><span class="status live">live archive</span><span>Base · Farcaster · NFT indexing</span></div>
          <h2 id="featured-title">WarpletScan</h2>
          <p class="featured-lede">A free, real-time, searchable archive of Warplet NFT mints on Base, enriched with Farcaster profiles and transaction evidence.</p>
          <p>WarpletScan tracks every indexed mint, resolves social identity, serves NFT media through resilient gateways, and links each record back to Basescan and OpenSea. The original mint closed in 2025. The public archive remains useful.</p>
          <div class="metric-row" aria-label="WarpletScan evidence">
            <div><strong>49,060</strong><span>NFT records synced</span></div>
            <div><strong>982</strong><span>result pages</span></div>
            <div><strong>Alchemy</strong><span>NFT and chain data</span></div>
          </div>
          <div class="link-row">
            <a class="button" href="https://warpletscan.xyz" target="_blank" rel="noreferrer">Open WarpletScan ↗</a>
            <a class="text-link" href="https://warpletscan.xyz/about" target="_blank" rel="noreferrer">Read the system notes ↗</a>
          </div>
        </div>
        <div class="warplet-evidence" aria-label="Real Warplet collection media and transaction evidence">
          <div class="warplet-grid">
            <img src="/assets/warplet-1.avif" alt="Warplet NFT from the indexed collection" width="700" height="700" loading="eager" />
            <img src="/assets/warplet-2.avif" alt="Warplet NFT from the indexed collection" width="700" height="700" loading="eager" />
            <img src="/assets/warplet-3.avif" alt="Warplet NFT from the indexed collection" width="700" height="700" loading="eager" />
          </div>
          <div class="evidence-console">
            <span>contract</span><code>0x6997...4b4e</code>
            <span>network</span><code>base / eip155:8453</code>
            <span>records</span><code>profile → wallet → tx → media</code>
            <a href="https://basescan.org/address/0x699727f9e01a822efdcf7333073f0461e5914b4e" target="_blank" rel="noreferrer">verify contract ↗</a>
          </div>
        </div>
      </div>
    </section>

    <section class="portfolio section-shell" aria-labelledby="portfolio-title">
      <div class="section-heading">
        <div>
          <div class="section-index">02 / CURRENT PORTFOLIO</div>
          <h2 id="portfolio-title">Different products.<br />One operating system.</h2>
        </div>
        <p>Current work is labeled by maturity. A prototype is not presented as a production system. Public source is not called open source without a license.</p>
      </div>
      <div class="project-grid">
        {projects.map((project, index) => (
          <article class:list={['project-card', `project-${index + 1}`]}>
            <div class="project-topline">
              <span class:list={['status', project.state.replace(' ', '-')]}>{project.state}</span>
              <span>{project.kind}</span>
            </div>
            {project.name === 'Castaway' && (
              <img class="project-art octopus" src="/assets/castaway-octopus.png" alt="Pixel-art octopus from Castaway" width="128" height="128" loading="lazy" />
            )}
            {project.name === 'Castora' && (
              <img class="project-art castora" src="/assets/castora-desktop.png" alt="Castora Farcaster client desktop interface" width="1920" height="1248" loading="lazy" />
            )}
            <div class="project-number">{String(index + 1).padStart(2, '0')}</div>
            <h3>{project.name}</h3>
            <p>{project.description}</p>
            <p class="proof"><span>Proof</span>{project.proof}</p>
            <ul class="tags" aria-label={`${project.name} technologies`}>
              {project.tags.map((tag) => <li>{tag}</li>)}
            </ul>
            <div class="card-links">
              <a href={project.url} target="_blank" rel="noreferrer">Open project ↗</a>
              {project.source && <a href={project.source} target="_blank" rel="noreferrer">Source ↗</a>}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="infrastructure section-shell" aria-labelledby="infra-title">
      <div class="section-index">03 / INFRASTRUCTURE LAYERS</div>
      <div class="infra-grid">
        <div>
          <h2 id="infra-title">The chain is not the product.<br /><em>It is one layer.</em></h2>
          <p>Arca uses onchain systems where public identity, settlement, ownership, and composability actually improve the product. Ordinary infrastructure stays ordinary.</p>
        </div>
        <dl class="infra-ledger">
          <div><dt>Identity</dt><dd>ERC-8004 registrations and verifiable metadata across EVM networks and Solana.</dd></div>
          <div><dt>Payments</dt><dd>x402, EIP-3009, USDC, Solana Pay, and wallet-native checkout experiments.</dd></div>
          <div><dt>Social</dt><dd>Farcaster clients, mini apps, profile enrichment, casts, signers, and portable identity.</dd></div>
          <div><dt>Data</dt><dd>NFT indexing, RPC access, contract reads, media resolution, and public explorer links.</dd></div>
          <div><dt>Operations</dt><dd>Node preflight, diagnostics, safe repair, sanitized reports, and source-backed support.</dd></div>
        </dl>
      </div>
    </section>

    <section id="history" class="history section-shell" aria-labelledby="history-title">
      <div class="section-heading">
        <div>
          <div class="section-index">04 / FIELD HISTORY</div>
          <h2 id="history-title">Before the company,<br />there was the work.</h2>
        </div>
        <p>Arca Computer was incorporated in 2026. The founder’s web3 practice started years earlier in art, virtual worlds, communities, and onchain social systems.</p>
      </div>
      <ol class="timeline">
        {history.map((item) => (
          <li>
            <div class="timeline-period">{item.period}</div>
            <div><h3>{item.title}</h3><p>{item.body}</p></div>
          </li>
        ))}
      </ol>
      <a class="text-link" href="https://felirami.com" target="_blank" rel="noreferrer">Open Luis Felipe’s full build log ↗</a>
    </section>

    <section id="receipts" class="receipts section-shell" aria-labelledby="receipts-title">
      <div class="receipt-callout">
        <p class="eyebrow">05 / PUBLIC EVIDENCE</p>
        <h2 id="receipts-title">Software should leave receipts.</h2>
        <p>Live products, source repositories, contracts, transaction explorers, package manifests, and contribution records. Claims stay attached to something another person can inspect.</p>
      </div>
      <div class="receipt-links">
        <a href="https://oss.arcabot.ai" target="_blank" rel="noreferrer"><span>Licensed code and upstream work</span><strong>Arca OSS ↗</strong></a>
        <a href="https://github.com/arcabotai" target="_blank" rel="noreferrer"><span>Products, tools, and experiments</span><strong>GitHub ↗</strong></a>
        <a href="https://arcabot.ai/#chains" target="_blank" rel="noreferrer"><span>Public onchain identity records</span><strong>Chain index ↗</strong></a>
        <a href="https://farcaster.xyz/felirami.eth" target="_blank" rel="noreferrer"><span>Primary builder social graph</span><strong>Farcaster ↗</strong></a>
      </div>
    </section>

    <section class="closing section-shell" aria-labelledby="closing-title">
      <p class="eyebrow">SANTIAGO / OPEN CHANNEL</p>
      <h2 id="closing-title">Build with the products.<br /><em>Inspect the boundary.</em></h2>
      <p>Arca Computer builds products, developer infrastructure, and public tools. Onchain when useful. Evidence by default.</p>
      <div class="hero-actions">
        <a class="button" href="mailto:contact@arca.computer">contact@arca.computer</a>
        <a class="text-link" href="https://arca.computer" target="_blank" rel="noreferrer">Arca Computer ↗</a>
      </div>
    </section>
  </main>

  <footer>
    <span>Arca Computer, Inc. / Santiago, Chile</span>
    <span>Web3 field index / 2021–2026</span>
  </footer>
</BaseLayout>
