{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web3-arca-computer",
  "main": "./src/worker.mjs",
  "compatibility_date": "2026-08-26",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "web3.arca.computer",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
